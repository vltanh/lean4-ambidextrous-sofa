module

public import AmbidextrousSofa.Analysis.ExactEstimates

@[expose] public section

/-!
# Exact scalar estimates for the initial-angle relaxation

The three-support calculation has an explicit stationary value. This file
optimizes that value in the width and cotangent parameters, retaining the
exact square-root endpoint and its comparison with the reference
constant. The square-root comparison uses squared inequalities, so no
derivative or numerical optimization is required.

The preliminary width estimates and two quadratic variation inequalities
are also proved here. The comparison of the actual finite-support integral
with its stationary value is a separate obligation; it is not assumed as
a scalar certificate in this file.
-/

noncomputable section

namespace AmbidextrousSofa

def initialAngleStationaryValue (K C k d : ℝ) : ℝ :=
  2 * C - 2 * (C - K / 2) ^ 2 - k * K * (C - d / 2)

/-- The optimized three-support value at the actual angular endpoint.
It is a geometric endpoint value, rather than an independently chosen budget. -/
def initialAngleEndpoint : ℝ :=
  (2 - (3 / 8 : ℝ)) ^ 2 / 8 + (Real.sqrt 2 - 1) *
    ((1 + (3 / 8 : ℝ)) / 2 - (3 / 8 : ℝ) ^ 2 / 4 + Real.sqrt 73 / 16)

/-- Complete the square in the width and optimize the cotangent interval. -/
theorem initialAngle_stationary_le_endpoint {C k d s : ℝ}
    (hk0 : 3 / 8 ≤ k) (hk1 : k ≤ 4 / 5) (hs0 : 0 ≤ s)
    (hs2 : s ^ 2 = 1 + k ^ 2) (hkd : k * d = s - 1) :
    initialAngleStationaryValue (Real.sqrt 2 - 1) C k d ≤ initialAngleEndpoint := by
  obtain ⟨hK0, -, hK1⟩ := sqrt_two_sub_one_bounds
  try dsimp only [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton] at *
  have hK := sqrt_two_sub_one_quadratic
  have hr0 : (8 : ℝ) ≤ √73 := Real.le_sqrt_of_sq_le (by norm_num)
  have hr2 := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 73)
  unfold initialAngleEndpoint
  generalize Real.sqrt 2 - 1 = K at *
  -- A secant bound for `s = √(1 + k²)` on `[3/8, 4/5]`.
  have hs : s ≤ √73 / 8 + 4 / 5 * (k - 3 / 8) := by
    refine (sq_le_sq₀ hs0 (by linarith)).mp ?_
    linarith only [hr2, hs2, mul_nonneg (sub_nonneg.2 hk0)
      (show 0 ≤ √73 / 5 - 3 / 4 - 9 / 25 * (k - 3 / 8) by linarith)]
  unfold initialAngleStationaryValue
  linarith [sq_nonneg (C - (1 / 2 + K * (2 - k) / 4)), congrArg (k * ·) hK,
    congrArg (K * ·) hkd, congrArg ((k - 3 / 8) * ·) hK,
    mul_le_mul_of_nonneg_left hs (by linarith : (0 : ℝ) ≤ K),
    mul_nonneg (sq_nonneg K) (mul_nonneg (sub_nonneg.2 hk0) (by linarith : (0 : ℝ) ≤ 49 / 40 - k)),
    mul_nonneg (sub_nonneg.2 hk0) (by linarith : (0 : ℝ) ≤ 3 - 5 * K)]

/-- The exact endpoint lies below the reference half-area. All numerical
enclosures are generated by Newton steps from small elementary brackets. -/
theorem initialAngleEndpoint_lt_referenceHalfAreaLower :
    initialAngleEndpoint < referenceHalfAreaLower := by
  obtain ⟨hK0, hK1, -⟩ := sqrt_two_sub_one_bounds
  try dsimp only [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton] at *
  have hr : √(73 : ℝ) < (9 + 73 / 9) / 2 :=
    (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
  have hcoef : 0 < (1 + (3 / 8 : ℝ)) / 2 - (3 / 8 : ℝ) ^ 2 / 4 + √73 / 16 := by
    positivity
  have hupper := mul_lt_mul_of_pos_right hK1 hcoef
  have hroot := mul_lt_mul_of_pos_left hr
    (show (0 : ℝ) < (diagonalOffsetUpper) / 16 by norm_num)
  have hcheck :
      (2 - (3 / 8 : ℝ)) ^ 2 / 8 + (diagonalOffsetUpper) *
        ((1 + (3 / 8 : ℝ)) / 2 - (3 / 8 : ℝ) ^ 2 / 4 + ((9 + 73 / 9) / 2) / 16) <
      referenceHalfAreaLower := by
    norm_num [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton, referenceHalfAreaLower, referenceRootLower, cubicBracketLower, cubicBracketUpper, cubic]
  unfold initialAngleEndpoint
  linarith only [hupper, hroot, hcheck]

theorem initialAngleEndpoint_lt_half_M : initialAngleEndpoint < M / 2 :=
  initialAngleEndpoint_lt_referenceHalfAreaLower.trans referenceHalfAreaLower_lt_half_M

theorem initialAngle_stationary_lt_half_M {C k d s : ℝ}
    (hk0 : 3 / 8 ≤ k) (hk1 : k ≤ 4 / 5) (hs0 : 0 ≤ s)
    (hs2 : s ^ 2 = 1 + k ^ 2) (hkd : k * d = s - 1) :
    initialAngleStationaryValue (Real.sqrt 2 - 1) C k d < M / 2 :=
  (initialAngle_stationary_le_endpoint hk0 hk1 hs0 hs2 hkd).trans_lt
    initialAngleEndpoint_lt_half_M

/-- The width required to separate the terminal corner at the initial-angle
endpoint. It solves `3 C sin α = 1 + cos α` at `tan α = 8/3`. -/
def initialAngleCornerWidth : ℝ := (Real.sqrt 73 + 3) / 24

/-- The diagonal score already excludes the geometric corner width.
The only enclosures are Newton steps for the two square roots. -/
theorem initialAngle_diagonal_corner_width {C : ℝ} (hC : C ≤ initialAngleCornerWidth) :
    2 * C - 2 * (C - (Real.sqrt 2 - 1) / 2) ^ 2 < referenceHalfAreaLower := by
  obtain ⟨hK0, hK1, hKcoarse⟩ := sqrt_two_sub_one_bounds
  have hK := sqrt_two_sub_one_quadratic
  have hr : Real.sqrt (73 : ℝ) ≤ squareRootNewton 73 9 :=
    sqrt_le_squareRootNewton (by norm_num) (by norm_num)
  have hCU : C ≤ (squareRootNewton 73 9 + 3) / 24 := by
    unfold initialAngleCornerWidth at hC
    dsimp only [squareRootNewton] at hr ⊢
    linarith
  have hcheck :
      2 * ((squareRootNewton 73 9 + 3) / 24) -
        2 * (((squareRootNewton 73 9 + 3) / 24) - diagonalOffsetUpper / 2) ^ 2 <
      referenceHalfAreaLower := by
    norm_num [diagonalOffsetUpper, squareRootNewton, referenceHalfAreaLower,
      referenceRootLower, cubicBracketLower, cubicBracketUpper, cubic]
  dsimp only [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton] at *
  generalize Real.sqrt 2 - 1 = K at *
  have hmono := mul_nonneg (sub_nonneg.mpr hCU)
    (show 0 ≤ 2 + 2 * K - 2 * ((squareRootNewton 73 9 + 3) / 24 + C) by
      dsimp only [squareRootNewton]; linarith)
  have hKmono := mul_nonneg (sub_nonneg.mpr hK1.le)
    (show 0 ≤ 2 * ((squareRootNewton 73 9 + 3) / 24) -
      (diagonalOffsetUpper + K) / 2 by
        dsimp only [diagonalOffsetUpper, squareRootNewton]; linarith)
  dsimp only [diagonalOffsetUpper, squareRootNewton] at hmono hKmono
  linarith

/-- At the natural width `C = K`, the diagonal value is `3K - 1/2`.
Every narrower width is below three quarters. -/
theorem initialAngle_diagonal_natural_width {C : ℝ} (hC : C ≤ Real.sqrt 2 - 1) :
    2 * C - 2 * (C - (Real.sqrt 2 - 1) / 2) ^ 2 < (3 / 4 : ℝ) := by
  obtain ⟨hK0, -, hK1⟩ := sqrt_two_sub_one_bounds
  dsimp only [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton] at *
  have hK := sqrt_two_sub_one_quadratic
  generalize Real.sqrt 2 - 1 = K at *
  linarith [mul_nonneg (sub_nonneg.mpr hC) (show 0 ≤ 2 - 2 * C by linarith)]

/-- The complementary tent gap comes from the minimum cotangent and
the diagonal offset, rather than a separate numerical tolerance. -/
def initialAngleComplementGap : ℝ := (1 + 3 * (3 / 8 : ℝ)) * (Real.sqrt 2 - 1) / 2

theorem initialAngleComplementGap_pos : 0 < initialAngleComplementGap := by
  unfold initialAngleComplementGap
  have h := sqrt_two_sub_one_bounds.1
  positivity

theorem initialAngleComplementScore_lt_half_M :
    1 - initialAngleComplementGap ^ 2 < M / 2 := by
  have hK := sqrt_two_sub_one_bounds.1
  have hgap : (1 + 3 * (3 / 8 : ℝ)) * diagonalOffsetLower / 2 <
      initialAngleComplementGap := by
    unfold initialAngleComplementGap
    exact div_lt_div_of_pos_right (mul_lt_mul_of_pos_left hK (by norm_num)) (by norm_num)
  have hcheck : 1 - ((1 + 3 * (3 / 8 : ℝ)) * diagonalOffsetLower / 2) ^ 2 <
      referenceHalfAreaLower := by
    norm_num [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton,
      referenceHalfAreaLower, referenceRootLower, cubicBracketLower, cubicBracketUpper, cubic]
  have hscore : 1 - initialAngleComplementGap ^ 2 < referenceHalfAreaLower := by
    dsimp only [diagonalOffsetLower, diagonalOffsetUpper, squareRootNewton] at hgap hcheck
    nlinarith
  exact hscore.trans referenceHalfAreaLower_lt_half_M

/-- Complete the width square after the geometric tent gap is paid. -/
theorem initialAngle_complement_bound {K C h : ℝ}
    (hK : K ^ 2 + 2 * K = 1) (hgap : initialAngleComplementGap < h - C) :
    2 * C - 2 * C ^ 2 + 2 * K * C - (h - C) ^ 2 < 1 - initialAngleComplementGap ^ 2 := by
  linarith [sq_nonneg (2 * C - 1 - K), mul_pos (sub_pos.mpr hgap)
    (show 0 < h - C + initialAngleComplementGap by linarith [initialAngleComplementGap_pos])]

/-- The two wall crossings jointly pay the negative tent-apex quadratic. -/
theorem initialAngle_apex_variation_budget {k ξ η ζ : ℝ}
    (hk0 : -1 < k) (hk1 : k < 1) :
    (ξ - η) ^ 2 / 2 ≤ (ξ - k * ζ) ^ 2 / (1 - k) +
      (η - k * ζ) ^ 2 / (1 + k) := by
  have hm : 0 < 1 - k := by linarith
  have hp : 0 < 1 + k := by linarith
  rw [div_add_div _ _ hm.ne' hp.ne', div_le_div_iff₀ two_pos (mul_pos hm hp)]
  linarith [sq_nonneg ((1 + k) * (ξ - k * ζ) + (1 - k) * (η - k * ζ))]

end AmbidextrousSofa
